# ==============================
# TourFlow - Git Ignore
# ==============================

# Environment & Secrets
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# Java
*.class
*.jar
*.war
*.ear

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/.nb-gradle/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Docker local overrides
docker-compose.override.yml

# Test / Coverage
.coverage/
coverage/
*.lcov

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# Kubernetes local files
*.secret.yaml
*-secret.yaml

# Generated files
generated/
out/

# Local development data
data/
tmp/
