					"beginsPattern": "^.*VITE v.*$",
					"endsPattern": "^.*ready in.*$"
				}
			}
		},
		{
			"label": "Run All Services",
			"dependsOn": [
				"Run: api-gateway",
				"Run: identity-service",
				"Run: catalog-service",
				"Run: booking-service",
				"Run: payment-service",
				"Run: mobility-service",
				"Run: engagement-service",
				"Run: platform-service",
				"Run: insights-service",
				"Run: search-service",
				"Run: frontend"
			],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Stop All Services",
			"type": "shell",
			"command": "taskkill //IM java.exe //F",
			"problemMatcher": []
		}
	]
}