{
	"//1": "Runs every already-built backend microservice plus the frontend dev server",
	"//2": "with a single command instead of starting them one by one in separate",
	"//3": "terminals. Backend services live under backend/services (and",
	"//4": "backend/gateway/api-gateway); the frontend lives under frontend/.",
	"//5": "",
	"//6": "Usage: Ctrl+Shift+B, or Command Palette -> \"Tasks: Run Task\" -> \"Run All Services\".",
	"//7": "Each service/app gets its own terminal panel (grouped under \"services\").",
	"//8": "",
	"//9": "Each backend service is built with `mvn clean package` and started via",
	"//10": "`java -jar`, not `mvn spring-boot:run`. spring-boot:run trusts a stale",
	"//11": "\"up to date\" timestamp check and can silently run an old/corrupted",
	"//12": "target/classes -- clean package + java -jar always reflects the current",
	"//13": "source. Add a new service by copying one Build/Run pair below and adding",
	"//14": "its Run label to \"Run All Services\".",
	"//15": "",
	"//16": "The frontend (Vite) has no build step in the dev loop -- \"Run: frontend\"",
	"//17": "just runs `npm run dev` directly. Run \"Install: frontend\" once (or after",
	"//18": "pulling dependency changes) before the first \"Run: frontend\".",
	"//19": "",
	"//20": "Backend was consolidated from 25 services down to 9 domain services +",
	"//21": "api-gateway (2026-09-06) -- see docs/decisions/ADR-002-SERVICE-CONSOLIDATION.md.",
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build: api-gateway",
			"type": "shell",
			"command": "mvn -o clean package -DskipTests",
			"options": {
				"cwd": "${workspaceFolder}/backend/gateway/api-gateway"
			},
			"problemMatcher": []
		},
		{
			"label": "Run: api-gateway",
			"type": "shell",
			"command": "java -jar target/api-gateway-0.0.1-SNAPSHOT.jar",
			"options": {
				"cwd": "${workspaceFolder}/backend/gateway/api-gateway"
			},
			"dependsOn": [
				"Build: api-gateway"
			],
			"isBackground": true,
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"group": "services"
			},
			"problemMatcher": {
				"owner": "api-gateway",
				"pattern": {
					"regexp": "^never-matches-anything$",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Starting ApiGatewayApplication.*$",
					"endsPattern": "^.*Started ApiGatewayApplication.*$"
				}
			}
		},
		{
			"label": "Build: identity-service",
