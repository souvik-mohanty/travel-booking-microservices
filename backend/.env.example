# Local PostgreSQL (Docker). These are the same defaults every service uses when
# DB_USERNAME / DB_PASSWORD / DB_NAME are not set, so keep them if you want the
# services to connect without extra configuration.
POSTGRES_USER=tour_user
POSTGRES_PASSWORD=tour_password
POSTGRES_DB=tour_planner

# Kafka UI (http://localhost:8085) login -- choose your own
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=

# Identity Service - Google OAuth2 (optional; see the README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Service - Razorpay test-mode keys (optional; needed for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
