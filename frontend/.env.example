# Every backend service is reached through the api-gateway's single base URL
# (see backend/gateway/api-gateway) -- the frontend never calls an individual
# service port directly.
VITE_API_BASE_URL=http://localhost:8080

# Production only: comma-separated public URLs of every backend service, pinged
# once on page load so sleeping free-tier services wake up in parallel.
# VITE_WARMUP_URLS=https://souvik-tourflow-gateway.onrender.com,https://souvik-tourflow-identity.onrender.com,...
